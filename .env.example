# GitHub repo secrets needed for deployments
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Terraform variables (for infrastructure provisioning)
CLOUDFLARE_ZONE_ID=

# R2 backend for Terraform state (S3-compatible credentials)
# Create at: CF Dashboard → R2 → Manage R2 API Tokens
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Backend Worker secrets (also set as GitHub repo secrets)
DB_HOST=mongodb+srv://user:password@cluster.mongodb.net/production?retryWrites=true&w=majority
JWT_SECRET=

# Local dev only
GALLERY_FOLDER=dist/assets/gallery
CLIENT_PORT=3000
ADMIN_PORT=5000
