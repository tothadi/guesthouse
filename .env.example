# Cloudflare Access
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# R2 backend for Terraform state (S3-compatible credentials)
# Create at: CF Dashboard → R2 → Manage R2 API Tokens
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# API runner VPS
VPS_HOST=
VPS_USER=
VPS_SSH_KEY=

# Backend secrets (also set as GitHub repo secrets)
DB_HOST=mongodb+srv://user:password@cluster.mongodb.net/production?retryWrites=true&w=majority
JWT_SECRET=
PORT=5000
